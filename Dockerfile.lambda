# Container image for AWS Lambda (Python 3.13).
# Build: docker build -f Dockerfile.lambda -t aagman-erp-api:latest .
# SAM: metadata in infra/sam/template.yaml points here.

FROM public.ecr.aws/lambda/python:3.13

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never

COPY --from=ghcr.io/astral-sh/uv:0.6.14 /uv /usr/local/bin/uv

WORKDIR ${LAMBDA_TASK_ROOT}

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project \
    && cp -r .venv/lib/python3.13/site-packages/* ${LAMBDA_TASK_ROOT}/

COPY app ${LAMBDA_TASK_ROOT}/app

CMD ["app.lambda_handler.handler"]
