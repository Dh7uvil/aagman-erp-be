ENV=development
APP_NAME=Aagman ERP API
DEBUG=false
LOG_LEVEL=INFO

DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=aagman_erp
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

JWT_SECRET=dev-only-change-me-use-32-chars-min!!
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_TTL_MINUTES=30
JWT_REFRESH_TOKEN_TTL_MINUTES=10080

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# Local object storage (MinIO via docker compose). Leave S3_ENDPOINT_URL empty in production for AWS S3.
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=aagman
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_PRESIGN_TTL_SECONDS=300

CORS_ORIGINS=

AUTH_RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# --- AWS Lambda (production via SAM) ---
# DATABASE_PASSWORD and JWT_SECRET are SAM deploy parameters → Lambda environment variables
# (see docs/deploy-aws.md). Amplify only needs API_URL and NEXT_PUBLIC_* — never DB/JWT secrets.
# ENV=production
# TRUSTED_PROXY_COUNT=1
# DATABASE_POOL_SIZE=2
# DATABASE_MAX_OVERFLOW=0
# CORS_ORIGINS=https://master.xxxxx.amplifyapp.com
# S3_BUCKET_NAME=your-bucket
# AWS_REGION=ap-south-1
# Omit S3_ENDPOINT_URL and AWS_ACCESS_KEY_* — Lambda uses the execution role for S3.
